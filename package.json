{
  "name": "worklift-app",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "WorkLift 本地个人工作生活APP（v1.2 工具箱扩展：Git 指南）",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint server.js public test",
    "lint:fix": "eslint server.js public test --fix",
    "format": "prettier --write server.js public test eslint.config.js",
    "format:check": "prettier --check server.js public test eslint.config.js"
  },
  "dependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
